# Copia este archivo como .env y completa los valores de tu proyecto de Supabase.
# (Supabase → Project Settings → API). El archivo .env no se sube al repositorio.
# Sin comillas ni espacios. La URL va sola, sin /rest/v1 al final: https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
